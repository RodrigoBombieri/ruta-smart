{
  "openapi": "3.1.0",
  "info": {
    "title": "RutaSmart Argentina",
    "version": "0.1.0",
    "description": "Operaciones implementadas. Routing piloto y cobertura parcial; sin cuentas sincronizadas."
  },
  "servers": [
    {
      "url": "http://localhost:5080",
      "description": "Desarrollo local"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/sessions/anonymous": {
      "post": {
        "operationId": "createSession",
        "responses": {
          "201": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/locations/search": {
      "get": {
        "operationId": "searchLocations",
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Location"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          }
        ]
      }
    },
    "/api/v1/trips/analyze": {
      "post": {
        "operationId": "analyzeTrip",
        "responses": {
          "201": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/trips/{id}": {
      "get": {
        "operationId": "getTrip",
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No existe o no pertenece a la sesión"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "delete": {
        "operationId": "deleteTrip",
        "responses": {
          "204": {
            "description": "Resultado"
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No existe o no pertenece a la sesión"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/trips/{id}/analyses": {
      "post": {
        "operationId": "reanalyzeTrip",
        "responses": {
          "201": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No existe o no pertenece a la sesión"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{8,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/status": {
      "get": {
        "operationId": "sourceStatus",
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceStatus"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/trips": {
      "get": {
        "operationId": "listTripsUnavailable",
        "summary": "Cuentas no habilitadas; guardado anónimo local",
        "responses": {
          "403": {
            "description": "Cuentas no configuradas",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error de validación, sesión, cuota o dependencia",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    },
    "schemas": {
      "Point": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "Location": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "georefId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label",
          "point"
        ]
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "fuelType": {
            "type": "string"
          },
          "tankLitres": {
            "type": "number"
          },
          "consumptionLPer100Km": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "fuelType",
          "tankLitres",
          "consumptionLPer100Km"
        ]
      },
      "Pause": {
        "type": "object",
        "properties": {
          "distanceM": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "distanceM",
          "durationSeconds"
        ]
      },
      "TripInput": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/Location"
          },
          "destination": {
            "$ref": "#/components/schemas/Location"
          },
          "departureAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/Vehicle"
          },
          "initialLitres": {
            "type": "number"
          },
          "reserveLitres": {
            "type": "number"
          },
          "manualPriceArsPerLitre": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "pauses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pause"
            }
          },
          "demo": {
            "type": "boolean"
          }
        },
        "required": [
          "origin",
          "destination",
          "departureAt",
          "timeZone",
          "vehicle",
          "initialLitres",
          "reserveLitres",
          "pauses"
        ]
      },
      "RouteData": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "synthetic": {
            "type": "boolean"
          },
          "geometry": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            }
          },
          "distanceM": {
            "type": "number"
          },
          "durationSeconds": {
            "type": "number"
          },
          "attribution": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "provider",
          "synthetic",
          "geometry",
          "distanceM",
          "durationSeconds",
          "attribution",
          "limitations"
        ]
      },
      "Passage": {
        "type": "object",
        "properties": {
          "distanceM": {
            "type": "number"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "earliest": {
            "type": "string",
            "format": "date-time"
          },
          "latest": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "distanceM",
          "at",
          "earliest",
          "latest"
        ]
      },
      "FuelResult": {
        "type": "object",
        "properties": {
          "consumedLitres": {
            "type": "number"
          },
          "initialRangeKm": {
            "type": "number"
          },
          "minimumPurchaseLitres": {
            "type": "number"
          },
          "consumptionCostArs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "minimumPurchaseCostArs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "priceOrigin": {
            "type": "string"
          },
          "planStatus": {
            "type": "string"
          }
        },
        "required": [
          "consumedLitres",
          "initialRangeKm",
          "minimumPurchaseLitres",
          "priceOrigin",
          "planStatus"
        ]
      },
      "Coverage": {
        "type": "object",
        "properties": {
          "dimension": {
            "type": "string"
          },
          "availability": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "dimension",
          "availability",
          "message"
        ]
      },
      "Reason": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "sourceRef": {
            "type": "string"
          },
          "evidenceVersion": {
            "type": "string"
          },
          "distanceFromM": {
            "type": "number"
          },
          "distanceToM": {
            "type": "number"
          },
          "validFrom": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "validTo": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "category",
          "severity",
          "message",
          "sourceRef",
          "evidenceVersion",
          "distanceFromM",
          "distanceToM",
          "confidence"
        ]
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "ruleVersion": {
            "type": "string"
          },
          "computedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "input": {
            "$ref": "#/components/schemas/TripInput"
          },
          "route": {
            "$ref": "#/components/schemas/RouteData"
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Passage"
            }
          },
          "fuel": {
            "$ref": "#/components/schemas/FuelResult"
          },
          "status": {
            "type": "string"
          },
          "coverage": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Coverage"
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reason"
            }
          },
          "weatherAlerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeatherMatch"
            }
          },
          "stations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationCandidate"
            }
          }
        },
        "required": [
          "tripId",
          "version",
          "ruleVersion",
          "computedAt",
          "validUntil",
          "input",
          "route",
          "timeline",
          "fuel",
          "status",
          "coverage",
          "reasons",
          "weatherAlerts",
          "stations"
        ]
      },
      "StationPrice": {
        "type": "object",
        "properties": {
          "amountArsPerLitre": {
            "type": "number"
          },
          "declaredAt": {
            "type": "string",
            "format": "date-time"
          },
          "schedule": {
            "type": "string"
          }
        },
        "required": [
          "amountArsPerLitre",
          "declaredAt",
          "schedule"
        ]
      },
      "FuelStation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "point": {
            "$ref": "#/components/schemas/Point"
          },
          "fuelType": {
            "type": "string"
          },
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StationPrice"
            }
          }
        },
        "required": [
          "id",
          "name",
          "brand",
          "address",
          "point",
          "fuelType",
          "prices"
        ]
      },
      "StationCandidate": {
        "type": "object",
        "properties": {
          "station": {
            "$ref": "#/components/schemas/FuelStation"
          },
          "distanceAlongM": {
            "type": "number"
          },
          "lateralDistanceM": {
            "type": "number"
          },
          "accessStatus": {
            "type": "string"
          },
          "withinInitialRangeWithoutDetour": {
            "type": "boolean"
          }
        },
        "required": [
          "station",
          "distanceAlongM",
          "lateralDistanceM",
          "accessStatus",
          "withinInitialRangeWithoutDetour"
        ]
      },
      "WeatherAlert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sender": {
            "type": "string"
          },
          "sent": {
            "type": "string",
            "format": "date-time"
          },
          "messageType": {
            "type": "string"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "type": "string"
          },
          "polygons": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Point"
              }
            }
          }
        },
        "required": [
          "id",
          "sender",
          "sent",
          "messageType",
          "references",
          "event",
          "severity",
          "description",
          "instruction",
          "from",
          "url",
          "polygons"
        ]
      },
      "WeatherMatch": {
        "type": "object",
        "properties": {
          "alert": {
            "$ref": "#/components/schemas/WeatherAlert"
          },
          "confidence": {
            "type": "string"
          },
          "distanceFromM": {
            "type": "number"
          },
          "distanceToM": {
            "type": "number"
          }
        },
        "required": [
          "alert",
          "confidence",
          "distanceFromM",
          "distanceToM"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "SourceStatus": {
        "type": "object",
        "properties": {
          "routing": {
            "type": "string"
          },
          "weather": {
            "type": "string"
          },
          "weatherDetail": {
            "type": "string"
          },
          "weatherLastSuccessAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "weatherRecords": {
            "type": "integer"
          },
          "weatherRejected": {
            "type": "integer"
          },
          "roads": {
            "type": "string"
          },
          "stations": {
            "type": "string"
          },
          "stationsDetail": {
            "type": "string"
          },
          "stationsCount": {
            "type": "integer"
          },
          "stationsUpdatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "prices": {
            "type": "string"
          },
          "accounts": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "demoAvailable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
